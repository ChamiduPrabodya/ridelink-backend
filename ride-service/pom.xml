<?xml version="1.0" encoding="UTF-8"?>


    <groupId>com.ridelink</groupId>
    <artifactId>ridelink-ride-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ridelink-ride-service</name>
